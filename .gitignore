# Credentials and machine-local configuration
.env
.env.*
!.env.example
.pi/auth.json
.pi/settings.local.json

# Dependency caches and agent runtime
node_modules/
.pi/npm/
.pi/git/
.pi/sessions/
.pi/subagent-runs/
.pi/subagents/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Reference import: keep market/signal data, macOS metadata and machine-local settings out of Git
/ref/auto_filter_stock/data/
/ref/**/.claude/settings.local.json
._*
/outputs/
/artifacts/
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.sqlite3-wal
*.sqlite3-shm
*.log
.DS_Store

# data/ goes into Git by whitelist (replan §11, Owner decision 2026-10-01): the two databases, the universe seed and
# confirmed event drafts. Anything else under data/ (legacy CSV layout from before P7: raw/, calendar/, ledger/, jobs/,
# the 09-25 kline snapshot; replay databases; temp files) stays out. Kept last so it overrides *.sqlite above.
/data/*
!/data/universe.csv
!/data/market.sqlite
!/data/ledger.sqlite
!/data/events/
