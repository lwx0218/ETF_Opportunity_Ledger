# 强势股智能筛选系统 - 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# ==================== 必需配置 ====================

# 同花顺问财Cookie（必需）
# 获取方法：访问 https://www.iwencai.com/ 登录后，在浏览器开发者工具中复制Cookie
PYWENCAI_COOKIE=

# ==================== 可选配置 ====================

# API服务器配置
API_HOST=0.0.0.0
API_PORT=8000

# 日志配置
LOG_LEVEL=INFO
